# Copy to .env.local, then enter credentials from Google Auth Platform > Clients.
# Never prefix these credentials with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Open the app at this exact origin. Use HTTPS in production.
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
APP_URL=http://localhost:3000

# Optional: defaults to data/taskspace.sqlite
# DATABASE_PATH=data/taskspace.sqlite
